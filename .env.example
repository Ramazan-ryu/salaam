# Copy to .env and adjust. Never commit real values.

# PostgreSQL with PostGIS, pg_trgm and citext extensions
DATABASE_URL=postgres://salaam:salaam@localhost:5432/salaam_dev
TEST_DATABASE_URL=postgres://salaam:salaam@localhost:5432/salaam_test

# API
API_PORT=4000
NODE_ENV=development

# DEV-ONLY authentication stand-in (until spike S-AUTH decides the real approach, ADR-0010).
# The API refuses to start with DEV_AUTH=true when NODE_ENV=production.
DEV_AUTH=true

# Web (admin & organizer portal)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dev identity the web app sends while DEV_AUTH is on (role: admin|curator|organizer)
DEV_USER_ID=founder
DEV_USER_ROLE=admin
